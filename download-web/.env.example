# Copy to .env.local for local dev, or set in your hosting provider
# Prefer separate links for Driver and Student apps
VITE_DRIVER_APK_URL=
VITE_STUDENT_APK_URL=

# Optional: require a passcode for Driver downloads (shown client-side)
VITE_DRIVER_PASSCODE=

# Fallback (if you only have one link):
# VITE_ANDROID_APK_URL=

VITE_SUPPORT_EMAIL=support@example.com
